[Unit]
Description=LLM Router — Free-Tier LLM Gateway
After=network.target

[Service]
Type=exec
User=mingl
WorkingDirectory=/home/mingl/work-enhancement/llm-router
EnvironmentFile=/home/mingl/work-enhancement/llm-router/.env
ExecStart=/home/mingl/.local/bin/uv run llm-router serve
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-router

[Install]
WantedBy=multi-user.target
