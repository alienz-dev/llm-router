[Unit]
Description=LLM Router — Free-Tier LLM Gateway
After=network.target

[Service]
Type=exec
# TODO: Replace with your username and install path
User=llm-router
WorkingDirectory=/opt/llm-router
EnvironmentFile=/opt/llm-router/.env
ExecStart=/usr/local/bin/uv run llm-router serve
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-router

[Install]
WantedBy=multi-user.target
